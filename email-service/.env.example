# Copy to .env and fill in. NEVER commit .env.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASSWORD = 16-char App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# true = implicit SSL (port 465); false = STARTTLS (port 587)
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
LOG_LEVEL=INFO
